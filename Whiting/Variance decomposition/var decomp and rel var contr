## projection matrix (A-matrix/Z)
Z <- as.matrix(nullmod_spat$tmb_obj$env$data$A_st) 

## information at the nodes (similar to Wood pp166)
node_info1 <- t(Z) %*% W1 %*% Z
node_info2 <- t(Z) %*% W2 %*% Z

## EDF using the posterior covariance
V_p1_ww <- solve(H_p1_ww) 
V_p2_ww <- solve(H_p2_ww) 
(edf_spatial1 <- sum(diag(as.matrix(V_p1_ww) %*% as.matrix(node_info1))))
(edf_spatial2 <- sum(diag(as.matrix(V_p2_ww) %*% as.matrix(node_info2))))

