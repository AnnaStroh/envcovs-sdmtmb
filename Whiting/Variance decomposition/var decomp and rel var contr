## RELATIVE VARIANCE CONTRIBUTION ANALYSIS
#### --------------------------------------------
### NOTE: Focus on spatial covariate only - but can easily be expanded

### Simulate MVN draws and calculation of the index for each simulation
nsim = 200

## simulate for model components - propagates uncertainty across estimate
set.seed(123)
bin_draws <- predict(covmod_spat, newdata = grid_yrs, 
                     nsim = nsim, model = 1)
dim(bin_draws)

set.seed(123)
logn_draws <- predict(covmod_spat, newdata = grid_yrs, nsim = nsim,
                             model = 2)
dim(logn_draws)

identical(bin_draws, logn_draws)

## Calculate density for each grid cell to estimate index
# binomial "index" has a fixed lognnormal component
years <- unique(row.names(bin_draws)) # same as for lognormal
area = 1 # same grid cell area
I_list <- list(I_bin = list(), I_logn = list(), I_full = list())
V_list <- list(V_bin = list(), V_logn = list(), V_full = list())

for (yr in years) {
  
  ## should be the same but make sure - but make sure
  idx_bin <- row.names(bin_draws) == yr
  idx_logn <- row.names(logn_draws) == yr
  
  ## Calculate fixed quantities across simulation draws but for each grid cell
  # transform to inverse of link function
  p_bar <- rowMeans(plogis(bin_draws[idx_bin, ]))
  mu_bar  <- rowMeans(exp(logn_draws[idx_logn, ]))
  
  ## Calculate Sobol' style indices
  # due to slight parameter changes, calculations remain within each draw
  
  # binomial index - holding lognormal fixed for any grid cell in given year
  I_list$I_bin[[yr]] <- colSums(plogis(bin_draws[idx_bin, ]) * mu_bar * area)
  
  # lognormal index - holding binomial fixed for any grid cell in given year
  I_list$I_logn[[yr]] <- colSums(p_bar * exp(logn_draws[idx_logn, ]) * area)
  
  # full index - multiplying binomial and lognormal grid cell values
  I_list$I_full[[yr]] <- colSums(plogis(bin_draws[idx_bin, ]) * exp(logn_draws[idx_logn, ]) * area)
  
  V_list$V_bin[[yr]] <- var(I_list$I_bin[[yr]])
  V_list$V_logn[[yr]] <- var(I_list$I_logn[[yr]])
  V_list$V_full[[yr]] <- var(I_list$I_full[[yr]])
  
}

