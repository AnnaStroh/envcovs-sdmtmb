## Decompose sources of variability for fixed and random effects
## joint precision matrix
H <- covmod_spat$sd_report$jointPrecision

## extract components
# intercepts
# no covariate
idx_beta_p1 <- which(colnames(H) == "b_j")
idx_beta_p2 <- which(colnames(H) == "b_j2")

str(H) # joint precision matrix "stacks" spatial random fields - no distinction for model component
# but mesh remains the same for each component, thus
tot_n_omegas <- table(unique(H@Dimnames))["omega_s"]
n_omegas <- table(unique(H@Dimnames))["omega_s"]/2 # total number of spatial effects/n model components
# should equal N mesh vertices
n_vertices <- covmod_spat$spde$mesh$n
n_omegas == n_vertices
# and it does

# extract spatial effects
idx_omega <- which(colnames(H) == "omega_s")
# given that spatial effects are ordered according to model component
idx_omega_p1 <- idx_omega[1:n_vertices]
idx_omega_p2 <- idx_omega[! idx_omega %in% idx_omega_p1]

## sub-blocks - used for Schur complement
H_p1_bb <- H[idx_beta_p1, idx_beta_p1] # A matrix (pxp, Schur context)
H_p1_bw <- H[idx_beta_p1, idx_omega_p1] # B matrix (pxq, Schur context)
H_p1_wb <- H[idx_omega_p1, idx_beta_p1] # C matrix (qxp, Schur context)
H_p1_ww <- H[idx_omega_p1, idx_omega_p1] # D matrix (qxq, Schur context)

# same matrix partitioning for positive catch rate predictor
H_p2_bb <- H[idx_beta_p2, idx_beta_p2] 
H_p2_bw <- H[idx_beta_p2, idx_omega_p2]
H_p2_wb <- H[idx_omega_p2, idx_beta_p2]
H_p2_ww <- H[idx_omega_p2, idx_omega_p2] 

rm(H)
## calculate the spatial penalty
spatial_penalty_p1 <- H_p1_bw %*% solve(H_p1_ww) %*% H_p1_wb
spatial_penalty_p2 <- H_p2_bw %*% solve(H_p2_ww) %*% H_p2_wb

## manual calculation of fixed effect variance
# compare between models
# with covariate
manual_vcov_p1 <- solve(H_p1_bb - spatial_penalty_p1) 
manual_vcov_p2 <- solve(H_p2_bb - spatial_penalty_p2)

sqrt(diag(manual_vcov_p1)) 
sqrt(diag(manual_vcov_p2)) 
