## manual dispersion calculation with the spatial penalty
res_binom <- residuals(fit_gam_binom, type = "pearson")
n_binom <- nrow(model_data)
p_binom <- length(coef(fit_gam_binom))
df_res_binom <- fit_gam_binom$df.residual

res_pos <- residuals(fit_gam_pos, type = "pearson")
n_pos <- nrow(pos_dat)
p_pos <- length(coef(fit_gam_pos))
df_res_pos <- fit_gam_pos$df.residual

## how well does the non-spatial model estimate uncertainty
edf_spatial1 / df_res_binom
edf_spatial2 / df_res_pos

## divide by the spatial-adjusted degrees of freedom (similar to Wood pp168-170)
dispersion_adj_binom <- sum(res_binom^2) / (df_res_binom - edf_spatial1)
res_pos <- res_pos[!is.na(res_pos)]
dispersion_adj_pos <- sum(res_pos^2) / (df_res_pos - edf_spatial2)
sqrt(dispersion_adj_pos)

# Adjusted Variance
vcov_adj_binom <- vcov(fit_gam_binom) * dispersion_adj_binom
sqrt(diag(vcov_adj_binom))

vcov_adj_pos <- vcov(fit_gam_pos) * dispersion_adj_pos
sqrt(diag(vcov_adj_pos))
